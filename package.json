    "faker": "^5.5.3",
    "faker-js": "^1.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "multer": "^1.4.5-lts.1",
